# Salin jadi .env untuk pengembangan lokal, dan set nilainya di Coolify untuk produksi.
# Di Coolify keempatnya harus ditandai "Available at Runtime" — nilai yang hanya
# tersedia saat build tidak terbaca oleh proses yang melayani permintaan.
# Kalau ada yang kosong, seluruh route /admin/** menjawab 503 (gagal-tertutup),
# dan log start-up menyebut variabel mana yang bolong.

# Kredensial masuk panel admin
NUXT_INTERNAL_AUTH_USER=
NUXT_INTERNAL_AUTH_PASSWORD=

# Kunci penyegel cookie sesi — minimal 32 karakter, acak.
# Buat dengan: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Koneksi PostgreSQL.
# Lokal (setelah `brew install postgresql@17` dan `createdb umrahsendiri_dev`):
#   postgresql://<user-mac-anda>@localhost:5432/umrahsendiri_dev
# Produksi: connection string internal dari database Postgres di Coolify.
DATABASE_URL=
